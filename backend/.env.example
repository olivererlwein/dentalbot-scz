PORT=3001
BOT_TIMEZONE=America/La_Paz

# Meta webhook verification
WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_APP_SECRET=replace_with_app_secret

# Meta Cloud API outbound
WHATSAPP_ACCESS_TOKEN=replace_with_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id

# Google Sheets sink (optional in MVP bootstrap)
# Suggested: Google Apps Script Web App URL that appends row to Sheets
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE/exec

# Scheduler API (Google Calendar source of truth)
SCHEDULER_PORT=3002
SCHEDULER_INTERNAL_BEARER=replace_with_internal_bearer
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth2callback
GOOGLE_CALENDAR_ID=dentalbot.scz@gmail.com
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_STORE_PATH=.secrets/google-oauth.json

# Scheduler API (Google Calendar source of truth)
SCHEDULER_PORT=3002
SCHEDULER_INTERNAL_BEARER=replace_with_internal_token
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
