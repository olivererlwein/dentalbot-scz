PORT=3001
BOT_TIMEZONE=America/La_Paz

# Meta webhook verification
WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_APP_SECRET=replace_with_app_secret

# Meta Cloud API outbound
WHATSAPP_ACCESS_TOKEN=replace_with_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id

# Google Sheets sink (optional in MVP bootstrap)
# Suggested: Google Apps Script Web App URL that appends row to Sheets
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE/exec
